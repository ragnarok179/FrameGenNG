 void VulkanHooks::Hook(HMODULE vulkan1)
 {
+    auto& state = State::Instance();
+    if (!IsSupportedBeamNGVulkanFrameGenerationOutput(state.activeFgOutput))
+    {
+        LOG_INFO("Vulkan passthrough enabled for unsupported Frame Generation output {}",
+                 magic_enum::enum_name(state.activeFgOutput));
+
+        Config::Instance()->FGEnabled.set_volatile_value(false);
+        state.activeFgInput = FGInput::NoFG;
+        state.activeFgOutput = FGOutput::NoFG;
+        state.activeFgNvngx = FGNvngxReplacement::None;
+        return;
+    }
+
     if (vulkanModule == nullptr)
         vulkanModule = vulkan1;
 
