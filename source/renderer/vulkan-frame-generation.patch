+void ReleaseBeamNGVulkanUpscalersBeforeShutdown()
+{
+    std::vector<unsigned int> handles;
+    handles.reserve(VkContexts.size());
+
+    for (const auto& [handleId, context] : VkContexts)
+    {
+        if (context.feature != nullptr)
+            handles.push_back(handleId);
+    }
+
+    LOG_INFO("BeamNG pre-exit: releasing {} Vulkan upscaler context(s) before device teardown", handles.size());
+    for (const auto handleId : handles)
+    {
+        NVSDK_NGX_Handle handle { handleId };
+        const auto result = NVSDK_NGX_VULKAN_ReleaseFeature(&handle);
+        LOG_INFO("BeamNG pre-exit: Vulkan upscaler {} release result {:X}", handleId, (UINT) result);
+    }
+}
