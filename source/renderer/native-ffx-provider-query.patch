+static ffxReturnCode_t QueryNativeUpscalerProviderVersion(ffxQueryDescHeader* desc)
+{
+    auto* providerDesc = reinterpret_cast<ffxQueryGetProviderVersion*>(desc);
+    const auto version = FfxApiProxy::VersionDx12_SR();
+
+    providerDesc->versionId =
+        0xF5A5'CA1Eui64 << 32 | (((version.major << 22) | (version.minor << 12) | version.patch) & 0xFFFFFFFF);
+
+    const auto versionName = std::format("{}.{}.{}", version.major, version.minor, version.patch);
+    providerDesc->versionName = _strdup(versionName.c_str());
+
+    LOG_DEBUG("Native upscaler provider version: {}", versionName);
+    return FFX_API_RETURN_OK;
+}
