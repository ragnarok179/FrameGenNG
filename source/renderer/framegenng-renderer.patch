+HRESULT FGHooks::hkSetColorSpace1(IDXGISwapChain3* This, DXGI_COLOR_SPACE_TYPE ColorSpace)
+{
+    const bool managesState = IsGameFacingFgSwapChain(This);
+    const bool previousMode = BeamNGHdrBridge::IsActive();
+    const bool requestedMode = managesState
+                                   ? BeamNGHdrBridge::ResolveForColorSpace(
+                                         ColorSpace, previousMode,
+                                         BeamNGHdrBridge::IsWindowsHdrActive(This))
+                                   : previousMode;
+    ColorSpace = BeamNGHdrBridge::TranslateColorSpace(ColorSpace, requestedMode);
+
+    const HRESULT result = o_FGSCSetColorSpace1(This, ColorSpace);
+    if (managesState && SUCCEEDED(result))
+        BeamNGHdrBridge::Publish(requestedMode);
+
+    return result;
+}
