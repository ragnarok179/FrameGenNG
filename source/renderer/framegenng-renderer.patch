diff --git a/FrameGenNGEngine/misc/BeamNGHdrBridge.h b/FrameGenNGEngine/misc/BeamNGHdrBridge.h
new file mode 100644
index 0000000..5a41be9
--- /dev/null
+++ b/FrameGenNGEngine/misc/BeamNGHdrBridge.h
@@ -0,0 +1,216 @@
+#pragma once
+
+#include <Config.h>
+#include <State.h>
+
+#include <dxgi1_6.h>
+
+namespace BeamNGHdrBridge
+{
+struct PresentationWindowClaim
+{
+    bool ownsState = false;
+    bool newlyAcquired = false;
+};
+
+inline bool IsEnabled()
+{
+    const auto* config = Config::Instance();
+    return config->ForceHDR.value_or_default() && config->UseHDR10.value_or_default();
+}
+
+inline constexpr bool ShouldUseHdr10Bridge(bool windowsHdrActive, bool beamNgHdrRequested)
+{
+    return windowsHdrActive && beamNgHdrRequested;
+}
+
+static_assert(!ShouldUseHdr10Bridge(false, false));
+static_assert(!ShouldUseHdr10Bridge(false, true));
+static_assert(!ShouldUseHdr10Bridge(true, false));
+static_assert(ShouldUseHdr10Bridge(true, true));
+
+inline bool IsHdrOutput(IDXGIOutput* output)
+{
+    if (output == nullptr)
+        return false;
+
+    IDXGIOutput6* output6 = nullptr;
+    if (FAILED(output->QueryInterface(IID_PPV_ARGS(&output6))) || output6 == nullptr)
+        return false;
+
+    DXGI_OUTPUT_DESC1 desc {};
+    const bool active = SUCCEEDED(output6->GetDesc1(&desc)) &&
+                        desc.ColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020;
+    output6->Release();
+    return active;
+}
+
+inline LONG64 IntersectionArea(const RECT& first, const RECT& second)
+{
+    const LONG width = (std::max)(0L, (std::min)(first.right, second.right) -
+                                         (std::max)(first.left, second.left));
+    const LONG height = (std::max)(0L, (std::min)(first.bottom, second.bottom) -
+                                          (std::max)(first.top, second.top));
+    return static_cast<LONG64>(width) * height;
+}
+
+inline bool IsWindowsHdrActive(IDXGIFactory* factory, HWND window)
+{
+    if (factory == nullptr || window == nullptr)
+        return false;
+
+    RECT windowBounds {};
+    if (!GetWindowRect(window, &windowBounds))
+        return false;
+
+    LONG64 largestIntersection = -1;
+    bool hdrActive = false;
+
+    for (UINT adapterIndex = 0;; ++adapterIndex)
+    {
+        IDXGIAdapter* adapter = nullptr;
+        const HRESULT adapterResult = factory->EnumAdapters(adapterIndex, &adapter);
+        if (adapterResult == DXGI_ERROR_NOT_FOUND)
+            break;
+        if (FAILED(adapterResult) || adapter == nullptr)
+            continue;
+
+        for (UINT outputIndex = 0;; ++outputIndex)
+        {
+            IDXGIOutput* output = nullptr;
+            const HRESULT outputResult = adapter->EnumOutputs(outputIndex, &output);
+            if (outputResult == DXGI_ERROR_NOT_FOUND)
+                break;
+            if (FAILED(outputResult) || output == nullptr)
+                continue;
+
+            DXGI_OUTPUT_DESC outputDesc {};
+            if (SUCCEEDED(output->GetDesc(&outputDesc)))
+            {
+                const LONG64 area = IntersectionArea(windowBounds, outputDesc.DesktopCoordinates);
+                if (area > largestIntersection)
+                {
+                    largestIntersection = area;
+                    hdrActive = IsHdrOutput(output);
+                }
+            }
+
+            output->Release();
+        }
+
+        adapter->Release();
+    }
+
+    return largestIntersection > 0 && hdrActive;
+}
+
+inline bool IsWindowsHdrActive(IDXGISwapChain* swapChain)
+{
+    if (swapChain == nullptr)
+        return false;
+
+    IDXGIOutput* output = nullptr;
+    if (FAILED(swapChain->GetContainingOutput(&output)) || output == nullptr)
+        return false;
+
+    const bool active = IsHdrOutput(output);
+    output->Release();
+    return active;
+}
+
+inline PresentationWindowClaim ClaimPresentationWindow(HWND window, bool internalSwapChain)
+{
+    if (window == nullptr || internalSwapChain)
+        return {};
+
+    DWORD windowProcessId = 0;
+    GetWindowThreadProcessId(window, &windowProcessId);
+    if (windowProcessId != GetCurrentProcessId())
+        return {};
+
+    auto& owner = State::Instance().beamNgPresentationWindow;
+    HWND current = owner.load(std::memory_order_acquire);
+
+    if (current == window)
+        return { true, false };
+
+    if (current != nullptr && IsWindow(current))
+        return {};
+
+    if (owner.compare_exchange_strong(current, window, std::memory_order_acq_rel))
+    {
+        LOG_INFO("BeamNG presentation window captured: {:X}", reinterpret_cast<size_t>(window));
+        return { true, true };
+    }
+
+    return { current == window, false };
+}
+
+inline void ReleasePresentationWindow(HWND window)
+{
+    HWND expected = window;
+    if (State::Instance().beamNgPresentationWindow.compare_exchange_strong(expected, nullptr,
+                                                                           std::memory_order_acq_rel))
+        LOG_INFO("BeamNG presentation window released: {:X}", reinterpret_cast<size_t>(window));
+}
+
+inline bool IsActive()
+{
+    return State::Instance().beamNgHdr10BridgeActive.load(std::memory_order_relaxed);
+}
+
+inline void Publish(bool active)
+{
+    const bool previous =
+        State::Instance().beamNgHdr10BridgeActive.exchange(active, std::memory_order_relaxed);
+    if (previous == active)
+        return;
+
+    LOG_INFO("BeamNG HDR10 bridge {}", active ? "enabled for scRGB input" : "disabled for SDR input");
+}
+
+inline bool ResolveForFormat(DXGI_FORMAT requestedFormat, bool currentMode, bool windowsHdrActive)
+{
+    if (!IsEnabled() || !windowsHdrActive)
+        return false;
+
+    if (requestedFormat == DXGI_FORMAT_UNKNOWN)
+        return currentMode;
+
+    return ShouldUseHdr10Bridge(
+        windowsHdrActive, requestedFormat == DXGI_FORMAT_R16G16B16A16_FLOAT);
+}
+
+inline DXGI_FORMAT TranslateFormat(DXGI_FORMAT requestedFormat, bool active)
+{
+    if (active && requestedFormat == DXGI_FORMAT_R16G16B16A16_FLOAT)
+        return DXGI_FORMAT_R10G10B10A2_UNORM;
+
+    return requestedFormat;
+}
+
+inline bool ResolveForColorSpace(DXGI_COLOR_SPACE_TYPE requestedColorSpace, bool currentMode,
+                                 bool windowsHdrActive)
+{
+    if (!IsEnabled() || !windowsHdrActive)
+        return false;
+
+    if (requestedColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709 ||
+        requestedColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020)
+        return ShouldUseHdr10Bridge(windowsHdrActive, true);
+
+    if (requestedColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709 ||
+        requestedColorSpace == DXGI_COLOR_SPACE_RGB_STUDIO_G22_NONE_P709)
+        return false;
+
+    return currentMode;
+}
+
+inline DXGI_COLOR_SPACE_TYPE TranslateColorSpace(DXGI_COLOR_SPACE_TYPE requestedColorSpace, bool active)
+{
+    if (active && requestedColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709)
+        return DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020;
+
+    return requestedColorSpace;
+}
+}
