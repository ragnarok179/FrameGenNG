+namespace
+{
+constexpr auto BeamNGSettingsPollInterval = std::chrono::milliseconds(500);
+constexpr auto BeamNGShutdownSignalPollInterval = std::chrono::milliseconds(10);
+constexpr char BeamNGFGEnabledKey[] = "BeamNGFrameGenerationEnabled";
+constexpr char BeamNGFGMultiplierKey[] = "BeamNGFrameGenerationMultiplier";
+constexpr wchar_t BeamNGShutdownSignalName[] = L"frame_generation_shutdown.signal";
+std::atomic_bool beamNGShutdownRequested = false;
+std::once_flag beamNGShutdownWatcherOnce;
+std::mutex beamNGShutdownTraceMutex;
+
+struct BeamNGHdrFormatTransition
+{
+    DXGI_FORMAT format = DXGI_FORMAT_UNKNOWN;
+    bool managesState = false;
+    bool previousMode = false;
+    bool requestedMode = false;
+};
+
+bool IsGameFacingFgSwapChain(IUnknown* swapChain)
+{
+    return swapChain != nullptr && swapChain == State::Instance().currentFGSwapchain;
+}
+
+BeamNGHdrFormatTransition PrepareBeamNGHdrFormatTransition(IDXGISwapChain* swapChain,
+                                                           DXGI_FORMAT requestedFormat,
+                                                           bool internalResize)
+{
+    BeamNGHdrFormatTransition transition {};
+    transition.previousMode = BeamNGHdrBridge::IsActive();
+    transition.requestedMode = transition.previousMode;
+    transition.managesState = !internalResize && IsGameFacingFgSwapChain(swapChain);
+
+    if (transition.managesState)
+    {
+        const bool windowsHdrActive = BeamNGHdrBridge::IsWindowsHdrActive(swapChain);
+        transition.requestedMode = BeamNGHdrBridge::ResolveForFormat(
+            requestedFormat, transition.previousMode, windowsHdrActive);
+        BeamNGHdrBridge::Publish(transition.requestedMode);
+
+        LOG_DEBUG("BeamNG FG swapchain resize: Windows HDR {}, requested format {}, bridge {}",
+                  windowsHdrActive, (UINT) requestedFormat, transition.requestedMode ? "HDR10" : "SDR");
+    }
+
+    transition.format =
+        BeamNGHdrBridge::TranslateFormat(requestedFormat, transition.requestedMode);
+    return transition;
+}
+
+void RollBackBeamNGHdrFormatTransition(const BeamNGHdrFormatTransition& transition, HRESULT result)
+{
+    if (transition.managesState && FAILED(result))
+    {
+        BeamNGHdrBridge::Publish(transition.previousMode);
+        LOG_WARN("BeamNG FG swapchain resize failed; restored {} bridge state (result {:X})",
+                 transition.previousMode ? "HDR10" : "SDR", (UINT) result);
+    }
+}
+
+std::filesystem::path BeamNGSettingsPath()
+{
+    static const auto path = [] {
+        char* localAppData = nullptr;
+        size_t localAppDataLength = 0;
+        if (_dupenv_s(&localAppData, &localAppDataLength, "LOCALAPPDATA") != 0 || localAppData == nullptr)
+            return std::filesystem::path {};
+
+        const std::filesystem::path launcherIni =
+            std::filesystem::path(localAppData) / "BeamNG" / "BeamNG.drive.ini";
+        free(localAppData);
+
+        const auto currentSettingsPath =
+            std::filesystem::path("current") / "settings" / "settings.json";
+
+        std::ifstream ini(launcherIni);
+        std::string line;
+        while (std::getline(ini, line))
+        {
+            constexpr char prefix[] = "userFolder =";
+            if (line.rfind(prefix, 0) != 0)
+                continue;
+
+            auto value = line.substr(sizeof(prefix) - 1);
+            const auto first = value.find_first_not_of(" \t\r\n");
+            const auto last = value.find_last_not_of(" \t\r\n");
+            if (first == std::string::npos)
+                break;
+
+            return std::filesystem::path(value.substr(first, last - first + 1)) / currentSettingsPath;
+        }
+
+        return launcherIni.parent_path() / "BeamNG.drive" / currentSettingsPath;
+    }();
+
+    return path;
+}
+
+void TraceBeamNGShutdown(const char* message, bool truncate = false)
+{
+    const auto settingsPath = BeamNGSettingsPath();
+    if (settingsPath.empty())
+        return;
+
+    std::scoped_lock lock(beamNGShutdownTraceMutex);
+    const auto tracePath = settingsPath.parent_path().parent_path() / "temp" / "frame_generation_shutdown.log";
+    std::ofstream trace(tracePath, truncate ? std::ios::trunc : std::ios::app);
+    if (trace)
+        trace << GetTickCount64() << '|' << message << '\n';
+}
+
+void StartBeamNGShutdownWatcher()
+{
+    std::call_once(beamNGShutdownWatcherOnce, [] {
+        const auto settingsPath = BeamNGSettingsPath();
+        if (settingsPath.empty())
+            return;
+
+        const auto signalPath = settingsPath.parent_path().parent_path() / "temp" / BeamNGShutdownSignalName;
+        std::error_code removeError;
+        std::filesystem::remove(signalPath, removeError);
+        TraceBeamNGShutdown("watcher-started", true);
+        std::thread([signalPath] {
+            // BeamNG's beamng.log is buffered and exposes its shutdown line too
+            // late. A GELua onPreExit extension creates this dedicated file while
+            // the D3D12 device and NGX objects are still alive.
+            while (!beamNGShutdownRequested.load(std::memory_order_relaxed))
+            {
+                std::error_code existsError;
+                if (std::filesystem::exists(signalPath, existsError))
+                {
+                    beamNGShutdownRequested.store(true, std::memory_order_release);
+                    TraceBeamNGShutdown("beamng-preexit-signal-observed");
+                    return;
+                }
+
+                std::this_thread::sleep_for(BeamNGShutdownSignalPollInterval);
+            }
+        }).detach();
+    });
+}
+
+void PollBeamNGFrameGenerationSettings(bool force = false)
+{
+    StartBeamNGShutdownWatcher();
+
+    static auto lastPoll = std::chrono::steady_clock::time_point::min();
+    static bool pathLogged = false;
+
+    const auto now = std::chrono::steady_clock::now();
+    if (!force && now - lastPoll < BeamNGSettingsPollInterval)
+        return;
+    lastPoll = now;
+
+    const auto path = BeamNGSettingsPath();
+    if (path.empty())
+        return;
+
+    std::ifstream settingsFile(path);
+    if (!settingsFile)
+        return;
+
+    const auto settings = nlohmann::json::parse(settingsFile, nullptr, false);
+    if (settings.is_discarded() || !settings.is_object())
+        return;
+
+    const auto enabledIt = settings.find(BeamNGFGEnabledKey);
+    const auto multiplierIt = settings.find(BeamNGFGMultiplierKey);
+    if (enabledIt == settings.end() || !enabledIt->is_boolean() || multiplierIt == settings.end() ||
+        !multiplierIt->is_number_integer())
+        return;
+
+    const bool enabled = enabledIt->get<bool>();
+    const int multiplier = std::clamp(multiplierIt->get<int>(), 2, 4);
+    const int interpolationCount = multiplier - 1;
+    auto* config = Config::Instance();
+
+    const bool enabledChanged = config->IsFGEnabled() != enabled;
+    const bool multiplierChanged = config->FGDLSSGInterpolationCount.value_or_default() != interpolationCount;
+    if (!enabledChanged && !multiplierChanged)
+        return;
+
+    config->FGEnabled.set_volatile_value(enabled);
+    config->FGDLSSGInterpolationCount.set_volatile_value(interpolationCount);
+    State::Instance().fgChanged = true;
+
+    if (!pathLogged)
+    {
+        LOG_INFO("BeamNG frame-generation settings connected to {}", path.string());
+        pathLogged = true;
+    }
+    LOG_INFO("BeamNG frame-generation settings applied: enabled={}, multiplier={}x", enabled, multiplier);
+}
