+static Fsr3::FfxErrorCode DispatchNativeFsr3(
+    Fsr3::FfxFsr3UpscalerContext* context, Fsr3::FfxFsr3UpscalerDispatchDescription* dispatchDescription)
+{
+    if (context == nullptr || dispatchDescription == nullptr || dispatchDescription->commandList == nullptr)
+        return Fsr3::FFX_ERROR_BACKEND_API_ERROR;
+
+    if (!_contexts.contains(context) &&
+        (!CreateNativeInputContext(context, dispatchDescription) || !_contexts.contains(context)))
