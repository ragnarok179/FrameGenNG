@@ -0,0 +1,50 @@
+#pragma once
+
+#include <upscalers/IFeature_Dx12.h>
+
+class NativeUpscalerInputDx12 final : public IFeature_Dx12
+{
+  private:
+    Upscaler _upscaler;
+    feature_version _version;
+
+  protected:
+    bool InitInternal(ID3D12GraphicsCommandList*, NVSDK_NGX_Parameter*) override { return true; }
+    bool EvaluateInternal(ID3D12GraphicsCommandList*, NVSDK_NGX_Parameter*) override { return true; }
+
+  public:
+    NativeUpscalerInputDx12(unsigned int handleId, NVSDK_NGX_Parameter* parameters, Upscaler upscaler,
+                            feature_version version)
+        : IFeature(handleId, parameters), IFeature_Dx12(handleId, parameters), _upscaler(upscaler), _version(version)
+    {
+        SetInit(SetInitParameters(parameters));
+    }
+
+    bool BeginFrame(NVSDK_NGX_Parameter* parameters)
+    {
+        if (!IsInited() || parameters == nullptr)
+            return false;
+
+        parameters->Get(NVSDK_NGX_Parameter_Width, &_renderWidth);
+        parameters->Get(NVSDK_NGX_Parameter_Height, &_renderHeight);
+
+        auto targetWidth = _targetWidth;
+        auto targetHeight = _targetHeight;
+        GetDynamicOutputResolution(parameters, &targetWidth, &targetHeight);
+
+        if (targetWidth > 0 && targetHeight > 0)
+        {
+            _targetWidth = targetWidth;
+            _targetHeight = targetHeight;
+            _displayWidth = _targetWidth;
+            _displayHeight = _targetHeight;
+        }
+
+        ++_frameCount;
+        return true;
+    }
+
+    bool IsWithDx12() override { return true; }
+    feature_version Version() override { return _version; }
+    Upscaler GetUpscalerType() const override { return _upscaler; }
+};
