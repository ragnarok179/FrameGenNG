+    parameters->Set(NVSDK_NGX_Parameter_DLSS_Pre_Exposure, dispatchDescription->preExposure);
+    parameters->Set(NVSDK_NGX_Parameter_Reset, dispatchDescription->reset ? 1 : 0);
+    parameters->Set(NVSDK_NGX_Parameter_Width, dispatchDescription->renderSize.width);
+    parameters->Set(NVSDK_NGX_Parameter_Height, dispatchDescription->renderSize.height);
+    parameters->Set(NVSDK_NGX_Parameter_DLSS_Render_Subrect_Dimensions_Width,
+                    dispatchDescription->renderSize.width);
+    parameters->Set(NVSDK_NGX_Parameter_DLSS_Render_Subrect_Dimensions_Height,
+                    dispatchDescription->renderSize.height);
+    parameters->Set(NVSDK_NGX_Parameter_Depth, dispatchDescription->depth.resource);
+    parameters->Set(NVSDK_NGX_Parameter_ExposureTexture, dispatchDescription->exposure.resource);
+    parameters->Set(NVSDK_NGX_Parameter_DLSS_Input_Bias_Current_Color_Mask,
+                    dispatchDescription->reactive.resource);
+    parameters->Set(NVSDK_NGX_Parameter_Color, dispatchDescription->color.resource);
+    parameters->Set(NVSDK_NGX_Parameter_MotionVectors, dispatchDescription->motionVectors.resource);
+    parameters->Set(NVSDK_NGX_Parameter_Output, dispatchDescription->output.resource);
+    parameters->Set("FSR.cameraNear", dispatchDescription->cameraNear);
+    parameters->Set("FSR.cameraFar", dispatchDescription->cameraFar);
+    parameters->Set("FSR.cameraFovAngleVertical", dispatchDescription->cameraFovAngleVertical);
+    parameters->Set("FSR.frameTimeDelta", dispatchDescription->frameTimeDelta);
+    parameters->Set("FSR.transparencyAndComposition", dispatchDescription->transparencyAndComposition.resource);
+    parameters->Set("FSR.reactive", dispatchDescription->reactive.resource);
+    parameters->Set("FSR.viewSpaceToMetersFactor", dispatchDescription->viewSpaceToMetersFactor);
+    parameters->Set(NVSDK_NGX_Parameter_Sharpness, dispatchDescription->sharpness);
+
+    if (dispatchDescription->color.resource != nullptr && dispatchDescription->color.state > 0)
+        Config::Instance()->ColorResourceBarrier.set_volatile_value(GetD3D12State(dispatchDescription->color.state));
+    if (dispatchDescription->depth.resource != nullptr && dispatchDescription->depth.state > 0)
+        Config::Instance()->DepthResourceBarrier.set_volatile_value(GetD3D12State(dispatchDescription->depth.state));
+    if (dispatchDescription->exposure.resource != nullptr && dispatchDescription->exposure.state > 0)
+        Config::Instance()->ExposureResourceBarrier.set_volatile_value(
