+    if (dispatchDescription->motionVectors.resource != nullptr && dispatchDescription->motionVectors.state > 0)
+        Config::Instance()->MVResourceBarrier.set_volatile_value(
+            GetD3D12State(dispatchDescription->motionVectors.state));
+    if (dispatchDescription->output.resource != nullptr && dispatchDescription->output.state > 0)
+        Config::Instance()->OutputResourceBarrier.set_volatile_value(GetD3D12State(dispatchDescription->output.state));
+    if (dispatchDescription->reactive.resource != nullptr && dispatchDescription->reactive.state > 0)
+        Config::Instance()->MaskResourceBarrier.set_volatile_value(
+            GetD3D12State(dispatchDescription->reactive.state));
+
+    auto& state = State::Instance();
+    state.setInputApiName = ApiUpscalerInput::FSR3_DX12;
+    state.currentFeature = feature;
+    if (!feature->BeginFrame(parameters))
+    {
+        LOG_WARN("Native FSR input metadata is unavailable; continuing with the game's FSR dispatch");
+        _skipDispatch = true;
+        const auto result = o_ffxFsr3UpscalerContextDispatch_Dx12(context, dispatchDescription);
+        _skipDispatch = false;
+        return result;
+    }
+
+    auto* commandList = static_cast<ID3D12GraphicsCommandList*>(dispatchDescription->commandList);
+    UpscalerInputsDx12::UpscaleStart(commandList, parameters, feature);
