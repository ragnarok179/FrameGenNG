+static bool IsSupportedBeamNGVulkanFrameGenerationOutput(FGOutput output)
+{
+    return output == FGOutput::FSRFG;
+}
+
+static void DisableUnsupportedBeamNGVulkanFrameGeneration()
+{
+    const auto output = State::Instance().activeFgOutput;
+    if (IsSupportedBeamNGVulkanFrameGenerationOutput(output) || output == FGOutput::NoFG)
+        return;
+
+    auto* config = Config::Instance();
+    if (config->IsFGEnabled())
+        LOG_INFO("Vulkan Frame Generation disabled for unsupported {} output; use FidelityFX Frame Generation",
+                 magic_enum::enum_name(output));
+
+    config->FGEnabled.set_volatile_value(false);
+}
