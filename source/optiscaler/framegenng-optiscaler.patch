+static void ApplyForcedHdr10ColorSpace(IDXGISwapChain* swapChain, DXGI_FORMAT format)
+{
+    if (swapChain == nullptr || format != DXGI_FORMAT_R10G10B10A2_UNORM ||
+        !Config::Instance()->ForceHDR.value_or_default() ||
+        !Config::Instance()->UseHDR10.value_or_default())
+        return;
+
+    IDXGISwapChain3* swapChain3 = nullptr;
+    if (FAILED(swapChain->QueryInterface(IID_PPV_ARGS(&swapChain3))) || swapChain3 == nullptr)
+    {
+        LOG_ERROR("ForceHDR10: created swapchain does not expose IDXGISwapChain3");
+        return;
+    }
+
+    constexpr auto hdr10ColorSpace = DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020;
+    UINT support = 0;
+    const auto supportResult = swapChain3->CheckColorSpaceSupport(hdr10ColorSpace, &support);
+    if (FAILED(supportResult) || (support & DXGI_SWAP_CHAIN_COLOR_SPACE_SUPPORT_FLAG_PRESENT) == 0)
+    {
+        LOG_ERROR("ForceHDR10: HDR10 present is unsupported, result: {:X}, flags: {:X}",
+                  (UINT) supportResult, support);
+        swapChain3->Release();
+        return;
+    }
+
+    const auto setResult = swapChain3->SetColorSpace1(hdr10ColorSpace);
+    if (FAILED(setResult))
+        LOG_ERROR("ForceHDR10: failed to set created swapchain to HDR10/BT.2100: {:X}", (UINT) setResult);
+    else
+        LOG_INFO("ForceHDR10: created R10 swapchain is now HDR10/BT.2100");
+
+    swapChain3->Release();
+}
