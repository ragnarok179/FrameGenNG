+        LOG_ERROR("ForceHDR10: DLSSG swapchain does not support HDR10 color space, result: {:X}, flags: {:X}",
+                  (UINT) supportResult, support);
+        swapChain3->Release();
+        return;
+    }
+
+    const auto setResult = swapChain3->SetColorSpace1(hdr10ColorSpace);
+    if (FAILED(setResult))
+        LOG_ERROR("ForceHDR10: failed to set DLSSG swapchain HDR10 color space: {:X}", (UINT) setResult);
+    else
+        LOG_INFO("ForceHDR10: DLSSG swapchain color space set to HDR10/BT.2100");
+
+    swapChain3->Release();
+}
